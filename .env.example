# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional custom API backend URL (defaults to same-origin proxy)
VITE_API_BASE_URL=""

# ANALYSIS_PROVIDER: "amd" | "auto" | "evolus" | "gemini" (defaults to "amd")
ANALYSIS_PROVIDER="amd"

# AMD Direct AI Configuration (Optional if using AMD model)
AMD_API_KEY=""
AMD_BASE_URL="https://developer.amd.com.cn/radeon/api/v1"
AMD_MODEL="DeepSeek-V4.1-Flash"

# Evolus Agent Configuration (Optional if using Evolus agent)
EVOLUS_APP_ID=""
EVOLUS_API_KEY=""
EVOLUS_AGENT_ID=""
EVOLUS_BASE_URL="https://api.evolus.ai/v1"
